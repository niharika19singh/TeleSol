# =================================================================
# TeleSol PayPilot & Sentinel — Environment Configuration Template
# =================================================================
# Note: This file contains safe placeholders. Never commit actual private keys or secrets.

# ── Server Configuration ──
PORT=8000
ALLOWED_ORIGINS=*
BACKEND_BASE_URL=http://localhost:8000
PAYPILOT_DB_PATH=backend/data/paypilot.db

# ── HashKey Settlement Protocol (HSP) Gateway ──
# When HSP credentials are omitted, PayPilot automatically runs in DEMO ADAPTER mode.
HSP_GATEWAY_URL=https://api.hashkeypay.com
HSP_MERCHANT_ID=MERCHANT_TELESOL_01
HSP_API_KEY=your_hsp_api_key_here
HSP_SECRET_KEY=your_hsp_secret_key_here

# ── HSK Chain (HashKey Chain) ──
# Testnet (Chain ID 133 / 0x85)
HSK_TESTNET_RPC=https://testnet.hsk.xyz
HSK_TESTNET_EXPLORER=https://testnet-explorer.hskchain.net

# Mainnet (Chain ID 177 / 0xb1)
HSK_MAINNET_RPC=https://mainnet.hsk.xyz
HSK_MAINNET_EXPLORER=https://hsk.blockscout.com

# ── Smart Contract Deployment (Optional / Testnet Only) ──
# Never set production mainnet keys here.
DEPLOYER_PRIVATE_KEY=
HSK_RPC_URL=https://testnet.hsk.xyz
HSK_CHAIN_ID=133

# ── TinyFish Web Agent API (Search & Fetch) ──
# Add your official TinyFish API Key below
TINYFISH_API_KEY=

# ── Frontend Configuration (Vite) ──
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
